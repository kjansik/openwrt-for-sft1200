Subject: [PATCH] net: dsa: mxl-gsw1xx: detect GL-SFT1200 GSW150 variant

Some GL-SFT1200 units have a GSW150 at SMDIO address 0 instead of the
GSW140 at 0x1f described by the board DTS. Check the manufacturer and
part IDs before selecting the GSW150 hardware data, and do so before
SerDes initialization because the GSW150 has no SerDes PCS.

Keep the configured MDIO device address and the GSW140 path unchanged.
The common switch operations already support the board's 802.1Q tagger.

---
--- a/drivers/net/dsa/lantiq/mxl-gsw1xx.c
+++ b/drivers/net/dsa/lantiq/mxl-gsw1xx.c
@@ -25,6 +25,7 @@
 
 struct gsw1xx_priv {
 	struct mdio_device	*mdio_dev;
+	int			mdio_addr;
 	int			smdio_badr;
 	struct			regmap *sgmii;
 	struct			regmap *gpio;
@@ -40,7 +41,7 @@
 				    unsigned int reg)
 {
 	struct mii_bus *bus = priv->mdio_dev->bus;
-	int sw_addr = priv->mdio_dev->addr;
+	int sw_addr = priv->mdio_addr;
 	int smdio_badr = priv->smdio_badr;
 	int res;
 
@@ -67,7 +68,7 @@
 {
 	struct gsw1xx_priv *priv = context;
 	struct mii_bus *bus = priv->mdio_dev->bus;
-	int sw_addr = priv->mdio_dev->addr;
+	int sw_addr = priv->mdio_addr;
 	int smdio_badr;
 	int res;
 
@@ -92,7 +93,7 @@
 {
 	struct gsw1xx_priv *priv = context;
 	struct mii_bus *bus = priv->mdio_dev->bus;
-	int sw_addr = priv->mdio_dev->addr;
+	int sw_addr = priv->mdio_addr;
 	int smdio_badr;
 	int res;
 
@@ -646,6 +647,54 @@
 			       GSW1XX_RST_REQ_SGMII_SHELL);
 }
 
+static const struct gswip_hw_info gsw150_data;
+
+static bool gsw1xx_manu_id_valid(u32 val)
+{
+	return (val & GSW1XX_SHELL_MANU_ID_FIX1) &&
+	       FIELD_GET(GSW1XX_SHELL_MANU_ID_MANID, val) ==
+	       GSW1XX_SHELL_MANU_ID_MANID_VAL;
+}
+
+static int gsw1xx_detect_sft1200(struct gsw1xx_priv *priv)
+{
+	struct device *dev = &priv->mdio_dev->dev;
+	u32 val, pnum;
+	int ret;
+
+	if (priv->mdio_addr != 0x1f ||
+	    !of_machine_is_compatible("glinet,gl-sft1200"))
+		return 0;
+
+	ret = regmap_read(priv->shell, GSW1XX_SHELL_MANU_ID, &val);
+	if (ret < 0)
+		return ret;
+	if (gsw1xx_manu_id_valid(val))
+		return 0;
+
+	/* Some GL-SFT1200 units carry a GSW150 at SMDIO address 0. */
+	priv->mdio_addr = 0;
+	priv->smdio_badr = GSW1XX_SMDIO_BADR_UNKNOWN;
+	ret = regmap_read(priv->shell, GSW1XX_SHELL_MANU_ID, &val);
+	if (ret < 0)
+		return ret;
+	if (!gsw1xx_manu_id_valid(val))
+		return -ENODEV;
+
+	pnum = FIELD_GET(GSW1XX_SHELL_MANU_ID_PNUML, val);
+	ret = regmap_read(priv->shell, GSW1XX_SHELL_PNUM_ID, &val);
+	if (ret < 0)
+		return ret;
+	pnum |= FIELD_GET(GSW1XX_SHELL_PNUM_ID_PNUMM, val) << 4;
+	if (pnum != 0x30)
+		return -ENODEV;
+
+	priv->gswip.hw_info = &gsw150_data;
+	dev_info(dev, "GL-SFT1200 GSW150 detected at SMDIO address 0\n");
+
+	return 0;
+}
+
 static int gsw1xx_probe(struct mdio_device *mdiodev)
 {
 	struct device *dev = &mdiodev->dev;
@@ -658,6 +707,7 @@
 		return -ENOMEM;
 
 	priv->mdio_dev = mdiodev;
+	priv->mdio_addr = mdiodev->addr;
 	priv->smdio_badr = GSW1XX_SMDIO_BADR_UNKNOWN;
 
 	priv->gswip.dev = dev;
@@ -697,6 +747,10 @@
 					 0xff);
 	if (IS_ERR(priv->shell))
 		return PTR_ERR(priv->shell);
+
+	ret = gsw1xx_detect_sft1200(priv);
+	if (ret < 0)
+		return ret;
 
 	ret = gsw1xx_serdes_pcs_init(priv);
 	if (ret < 0)
--- a/drivers/net/dsa/lantiq/mxl-gsw1xx.h
+++ b/drivers/net/dsa/lantiq/mxl-gsw1xx.h
@@ -110,6 +110,13 @@
 #define GSW1XX_SHELL_BASE			0xfa00
 #define  GSW1XX_SHELL_RST_REQ			0x01
 #define   GSW1XX_RST_REQ_SGMII_SHELL		BIT(5)
+#define  GSW1XX_SHELL_MANU_ID			0x10
+#define   GSW1XX_SHELL_MANU_ID_FIX1		BIT(0)
+#define   GSW1XX_SHELL_MANU_ID_MANID		GENMASK(11, 1)
+#define   GSW1XX_SHELL_MANU_ID_MANID_VAL		0x389
+#define   GSW1XX_SHELL_MANU_ID_PNUML		GENMASK(15, 12)
+#define  GSW1XX_SHELL_PNUM_ID			0x11
+#define   GSW1XX_SHELL_PNUM_ID_PNUMM		GENMASK(11, 0)
 /* RGMII PAD Slew Control Register */
 #define  GSW1XX_SHELL_RGMII_SLEW_CFG		0x78
 #define   RGMII_SLEW_CFG_DRV_TXC		BIT(2)
