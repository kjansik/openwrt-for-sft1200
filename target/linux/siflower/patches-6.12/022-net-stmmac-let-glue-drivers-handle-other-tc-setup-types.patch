From: alex <todadzealexi19@proton.me>
Subject: [PATCH] net: stmmac: let glue drivers handle other tc setup types

Some SoCs integrate offload hardware into the GMAC that only the glue
driver knows about. Add a setup_tc callback to the platform data and
call it for tc setup types stmmac doesn't handle itself.

---
 drivers/net/ethernet/stmicro/stmmac/stmmac_main.c | 3 +++
 include/linux/stmmac.h                            | 3 +++
 2 files changed, 6 insertions(+)

diff --git a/drivers/net/ethernet/stmicro/stmmac/stmmac_main.c b/drivers/net/ethernet/stmicro/stmmac/stmmac_main.c
index 131967eff..b24bb82e4 100644
--- a/drivers/net/ethernet/stmicro/stmmac/stmmac_main.c
+++ b/drivers/net/ethernet/stmicro/stmmac/stmmac_main.c
@@ -6283,6 +6283,9 @@ static int stmmac_setup_tc(struct net_device *ndev, enum tc_setup_type type,
 	case TC_SETUP_QDISC_ETF:
 		return stmmac_tc_setup_etf(priv, priv, type_data);
 	default:
+		if (priv->plat->setup_tc)
+			return priv->plat->setup_tc(ndev, priv->plat->bsp_priv,
+						    type, type_data);
 		return -EOPNOTSUPP;
 	}
 }
diff --git a/include/linux/stmmac.h b/include/linux/stmmac.h
index ceb057a98..14dc1f57b 100644
--- a/include/linux/stmmac.h
+++ b/include/linux/stmmac.h
@@ -12,6 +12,7 @@
 #ifndef __STMMAC_PLATFORM_DATA
 #define __STMMAC_PLATFORM_DATA
 
+#include <linux/netdevice.h>
 #include <linux/platform_device.h>
 #include <linux/phylink.h>
 
@@ -238,6 +239,8 @@ struct plat_stmmacenet_data {
 	void (*ptp_clk_freq_config)(struct stmmac_priv *priv);
 	int (*init)(struct platform_device *pdev, void *priv);
 	void (*exit)(struct platform_device *pdev, void *priv);
+	int (*setup_tc)(struct net_device *ndev, void *priv,
+			enum tc_setup_type type, void *type_data);
 	struct mac_device_info *(*setup)(void *priv);
 	int (*clks_config)(void *priv, bool enabled);
 	int (*crosststamp)(ktime_t *device, struct system_counterval_t *system,
